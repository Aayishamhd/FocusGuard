# FocusGuard Desktop Environment Configuration
# Copy this file to `desktop/.env.local` to connect to live backends:

# Set to "false" to connect to live services on port 5001 and 5002
# Set to "true" (or omit) to run in mock mode
VITE_USE_MOCKS=false

# Feature 1: Attention Engine (HTTP + SSE)
VITE_ENGINE_URL=http://127.0.0.1:5001

# Feature 2: AI Assistant (HTTP REST + Ollama)
VITE_ASSISTANT_URL=http://127.0.0.1:5002
