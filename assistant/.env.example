# FocusGuard — AI Assistant Service
# Copy this file to `.env` and fill in your values.
#
# The service runs with sensible defaults without a .env file.
# Override only what you need.

# --- Ollama ---
# URL of the local Ollama service
OLLAMA_URL=http://127.0.0.1:11434

# Model to use (must be pulled via: ollama pull <model>)
# Recommended options: llama3.2, phi3, mistral
OLLAMA_MODEL=llama3.2

# Timeout in seconds for a single Ollama request before falling back to heuristics
OLLAMA_TIMEOUT_SECONDS=5

# --- Service ---
# Port this assistant service listens on
ASSISTANT_PORT=5002

# Host (use 0.0.0.0 to expose beyond localhost, 127.0.0.1 for local-only)
ASSISTANT_HOST=127.0.0.1

# --- Logging ---
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Behaviour ---
# Set to "true" to force heuristic fallback even if Ollama is available.
# Useful for testing the fallback path without stopping Ollama.
FORCE_FALLBACK=false
